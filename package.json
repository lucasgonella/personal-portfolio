{
  "name": "gonella-personal-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts/*.mjs tests vite.config.ts",
    "test": "node --test tests/deploy.test.mjs",
    "test:e2e": "playwright test",
    "refresh:projects": "node scripts/refresh-projects.mjs",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir .deploy/ssr && node scripts/prerender.mjs && python scripts/ftp.py manifest",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "deploy:inventory": "python scripts/ftp.py inventory",
    "deploy": "python scripts/ftp.py deploy",
    "deploy:verify": "python scripts/ftp.py verify",
    "rollback": "python scripts/ftp.py rollback"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "gsap": "3.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "chrome-launcher": "1.2.2",
    "eslint": "10.12.0",
    "lighthouse": "13.5.0",
    "postcss": "8.5.29",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.64.5",
    "esbuild": "npm:esbuild-wasm@0.28.1"
  }
}
